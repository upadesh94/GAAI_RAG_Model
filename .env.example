# Google Gemini API Configuration
GEMINI_API_KEY=your_api_key_here

# Configurable Model Identifiers
# Supported embedding models: gemini-embedding-2, gemini-embedding-001
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Supported generation models: gemini-3.5-flash-lite, gemini-3.5-flash, gemini-3.8-flash
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite

# RAG & Chunking Parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=4

# Storage & File Settings
CHROMA_PERSIST_DIR=.chromadb
MAX_FILE_SIZE_MB=10
